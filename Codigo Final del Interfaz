#Tipo de cambio
def get_tipo_cambio():
    try:
        r = requests.get("https://api.exchangerate-api.com/v4/latest/USD", timeout=5)
        return r.json()["rates"]["CRC"]
    except:
        return 520

tipo_cambio = get_tipo_cambio()

#Comunicación con la Rasp
def pico_get(ruta, timeout=3):
    if not PICO_IP:
        return None
    try:
        r = requests.get(f"http://{PICO_IP}{ruta}", timeout=timeout)
        return r.json()
    except:
        return None

def actualizar_desde_pico():
    """Hilo que sincroniza stock y ventas desde la Pico cada segundo."""
    while True:
        datos = pico_get("/status")
        if datos:
            for i in range(3):
                stock[i]  = datos["stock"][i]
                ventas[i] = datos["ventas"][i]
        threading.Event().wait(1)

threading.Thread(target=actualizar_desde_pico, daemon=True).start()

#Helpers UI
def hacer_btn(parent, texto, comando, color="#7EB8F7", side=None, **pack_opts):
    lbl = tk.Label(parent, text=texto, bg=color, fg="white",
                   padx=14, pady=8, cursor="hand2", width=28,
                   font=("Arial", 13, "bold"))
    lbl.bind("<Button-1>", lambda e: comando())
    if side:
        lbl.pack(side=side)
    else:
        lbl.pack(**pack_opts)
    return lbl

