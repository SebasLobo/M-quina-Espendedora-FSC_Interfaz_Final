#Descubrimiento de la Pico por WiFi
PICO_IP   = None
BUSCANDO  = True

def descubrir_pico():
    global PICO_IP, BUSCANDO
    for i in range(2, 15):
        ip = f"172.20.10.{i}"
        try:
            r = requests.get(f"http://{ip}/status", timeout=0.8)
            if r.status_code == 200 and "stock" in r.json():
                PICO_IP = ip
                BUSCANDO = False
                return
        except:
            continue
    BUSCANDO = False  #No encontrada

threading.Thread(target=descubrir_pico, daemon=True).start()

